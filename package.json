{
  "name": "wuwa-afyg-share",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:ui": "node scripts/check-ui.mjs",
    "check:css": "node scripts/check-css-routes.mjs",
    "check:accept": "node scripts/acceptance.mjs",
    "check:dead": "node scripts/find-dead-code.mjs",
    "check:shadow": "node scripts/check-shadow.mjs",
    "check:lock": "node scripts/check-lock-ui.mjs",
    "check:all": "node scripts/check-ui.mjs && node scripts/check-css-routes.mjs && node scripts/check-shadow.mjs && node scripts/check-lock-ui.mjs && node scripts/acceptance.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
